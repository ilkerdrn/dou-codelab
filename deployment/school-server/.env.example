# Uygulama
APP_ENV=production
APP_VERSION=1.0.0
APP_DOMAIN=codelab.dogus.edu.tr
APP_URL=https://codelab.dogus.edu.tr
TZ=Europe/Istanbul

# PostgreSQL - üretimde güçlü ve benzersiz değerlerle değiştirin
POSTGRES_DB=dou_codelab
POSTGRES_USER=dou_codelab
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://dou_codelab:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/dou_codelab

# Redis
REDIS_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
REDIS_URL=redis://:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@redis:6379/0

# S3 uyumlu dosya depolama
MINIO_ROOT_USER=dou_codelab_storage
MINIO_ROOT_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
S3_ENDPOINT=http://minio:9000
S3_BUCKET=dou-codelab
S3_ACCESS_KEY=dou_codelab_storage
S3_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

# Microsoft Entra ID - Doğuş Üniversitesi BT biriminden alınacak
ENTRA_TENANT_ID=REQUEST_FROM_DOGUS_IT
ENTRA_CLIENT_ID=REQUEST_FROM_DOGUS_IT
ENTRA_CLIENT_SECRET=REQUEST_FROM_DOGUS_IT
ENTRA_REDIRECT_URI=https://codelab.dogus.edu.tr/api/auth/callback/microsoft-entra-id
ALLOWED_EMAIL_DOMAIN=dogus.edu.tr

# Güvenlik
AUTH_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
ENCRYPTION_KEY=GENERATE_32_BYTE_KEY

# İsteğe bağlı entegrasyonlar
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DOU CodeLab <noreply@dogus.edu.tr>
